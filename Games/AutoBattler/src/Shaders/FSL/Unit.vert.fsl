#include "../../../../../Common_3/Graphics/ShaderUtilities.h.fsl"
#include "AutoBattler.h.fsl"
#include "Global.srt.h"

STRUCT(VSInput)
{
    DATA(float3, Position, POSITION);
    DATA(uint, Normal, NORMAL);
    DATA(uint, UV, TEXCOORD0);
    DATA(float4, BoneWeights, WEIGHTS);
    DATA(uint4, BoneIndices, JOINTS);
};

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(float3, Normal, NORMAL);
    DATA(float2, UV, TEXCOORD0);
    DATA(float4, Color, COLOR0);
};

// Rows r0-r2 of an affine matrix times v, as affineMul() in AnimationBake.h.
float3 affineMul(float4 r0, float4 r1, float4 r2, float4 v) { return float3(dot(r0, v), dot(r1, v), dot(r2, v)); }

ROOT_SIGNATURE(DefaultRootSignature)
VSOutput VS_MAIN(VSInput In, SV_InstanceID(uint) instanceId)
{
    INIT_MAIN;
    VSOutput Out;

    // Instances are the units that passed culling; each samples its own frame of the baked animation table.
    uint     entry = gVisibleUnits[instanceId];
    uint     unit = entry & ((1u << VISIBLE_LOD_SHIFT) - 1u);
    UnitInstance inst = gUnitInstances[unit];
    uint         palette = inst.pose & UNIT_POSE_OFFSET_MASK;
    // Blend towards the next baked frame (each clip ends with a copy of its first frame); LOD2 is too
    // small on screen to notice and reads one frame.
    float blend = (entry >> VISIBLE_LOD_SHIFT) < 2u ? float(inst.pose >> 24) / 255.0f : 0.0f;

    // Each influence: mesh joint -> rig joint pose in the shared table, times this mesh's inverse bind.
    float3 model = float3(0.0f, 0.0f, 0.0f);
    float3 normal = float3(0.0f, 0.0f, 0.0f);
    float3 normalIn = decodeDir(unpackUnorm2x16(In.Normal));
    for (uint k = 0; k < 4; ++k)
    {
        SkinJoint skin = gSkinJoints[In.BoneIndices[k]];
        Affine    pose = gBonePalettes[palette + skin.rigJoint];
        if (blend > 0.0f)
        {
            Affine next = gBonePalettes[palette + gFrame.rigJointCount + skin.rigJoint];
            pose.row0 = lerp(pose.row0, next.row0, blend);
            pose.row1 = lerp(pose.row1, next.row1, blend);
            pose.row2 = lerp(pose.row2, next.row2, blend);
        }
        float3 bindPos = affineMul(skin.bind0, skin.bind1, skin.bind2, float4(In.Position, 1.0f));
        float3 bindNormal = affineMul(skin.bind0, skin.bind1, skin.bind2, float4(normalIn, 0.0f));
        model += In.BoneWeights[k] * affineMul(pose.row0, pose.row1, pose.row2, float4(bindPos, 1.0f));
        normal += In.BoneWeights[k] * affineMul(pose.row0, pose.row1, pose.row2, float4(bindNormal, 0.0f));
    }

    // World = translation(x, 0, z) * rotationY(yaw) * scale, as unitWorldMatrix() in UnitInstance.h.
    float  c = cos(inst.yaw);
    float  s = sin(inst.yaw);
    float3 worldPos = float3(inst.x + inst.scale * (c * model.x + s * model.z), inst.scale * model.y,
                             inst.z + inst.scale * (c * model.z - s * model.x));
    Out.Position = mul(gFrame.viewProj, float4(worldPos, 1.0f));
    Out.Normal = normalize(float3(c * normal.x + s * normal.z, normal.y, c * normal.z - s * normal.x));
    Out.UV = unpack2Floats(In.UV);
    Out.Color = float4(gFrame.teamColors[inst.tintFlash & 0xffu].rgb, float((inst.tintFlash >> 8) & 0xffu) / 255.0f);
    if ((gFrame.debugFlags & DEBUG_LOD_COLORS) != 0)
    {
        uint lod = entry >> VISIBLE_LOD_SHIFT;
        Out.Color.rgb = lod == 0 ? float3(0.2f, 1.0f, 0.2f) : (lod == 1 ? float3(1.0f, 0.9f, 0.1f) : float3(1.0f, 0.15f, 0.1f));
    }
    RETURN(Out);
}
